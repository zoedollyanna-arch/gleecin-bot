# Copy this file to .env and fill in real values.
# .env is gitignored — never put real tokens or passwords in this file.

# ---- Discord bot ----
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=your_server_guild_id_here
PORT=10000

# ---- Database ----
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Welcome System ----
ENTRY_CHANNEL_ID=your_entry_channel_id_here
VISITOR_ROLE_ID=your_visitor_role_id_here
MEMBER_ROLE_ID=your_member_role_id_here

# ---- Main Channels ----
GENERAL_CHANNEL_ID=your_general_chat_channel_id_here
GALLERY_CHANNEL_ID=your_gallery_channel_id_here
REVIEWS_CHANNEL_ID=your_reviews_channel_id_here
SUPPORT_CHANNEL_ID=your_support_channel_id_here
CLIENT_ROLE_ID=your_client_role_id_here

# ---- Staff Configuration ----
STAFF_ROLE_ID=your_staff_role_id_here
INSTRUCTOR_ROLE_ID=your_instructor_role_id_here

# ---- Scripting Academy ----
STUDENT_ROLE_ID=your_student_role_id_here
CLASS_UPDATES_CHANNEL_ID=your_class_updates_channel_id_here
DEBUG_SUPPORT_CHANNEL_ID=your_debug_support_channel_id_here
SHOWCASE_CHANNEL_ID=your_student_showcase_channel_id_here

# ---- Tickets ----
COMMISSION_CATEGORY_ID=category_new_commission_tickets_go_under
SUPPORT_CATEGORY_ID=category_new_support_tickets_go_under
CLASS_CATEGORY_ID=category_class_applications_go_under

# Closing a ticket saves the full transcript to the database and deletes the
# channel, so closed tickets never pile up in the server. Retrieve them with
# /ticket history. Optionally mirror each closed ticket to a log channel too.
TICKET_LOG_CHANNEL_ID=

# Where website support tickets get announced.
# Falls back to SUPPORT_CHANNEL_ID if unset.
WEB_TICKET_CHANNEL_ID=staff_channel_for_website_tickets

# ---- Website ----
PUBLIC_URL=https://your-service.onrender.com
SESSION_SECRET=random_string_for_session_signing
